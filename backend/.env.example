# ==============================================================================
# ACADEMY CRM — BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy to backend/.env after completing CRM_DNA.md onboarding
# NEVER reuse another client's Supabase or WhatsApp Bridge URL/Key!
# ==============================================================================

NODE_ENV=development
APP_ENV=development
PORT=10000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# 1. ISOLATED SUPABASE PROJECT (Fresh project per client)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 2. WHATSAPP GATEWAY BRIDGE (Render Account #2 - Isolated OpenWA / Baileys)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=openwa
OPENWA_API_URL=https://YOUR_CLIENT_OPENWA_BRIDGE.onrender.com
OPENWA_API_KEY=YOUR_UNIQUE_GENERATED_MASTER_KEY
WHATSAPP_LINKED_DEVICE_URL=https://YOUR_CLIENT_OPENWA_BRIDGE.onrender.com
WHATSAPP_LINKED_DEVICE_TOKEN=YOUR_UNIQUE_GENERATED_MASTER_KEY
WHATSAPP_DAILY_LIMIT=100

# 3. INITIAL SEED AUTH ACCOUNTS
DEV_ADMIN_EMAIL=admin@youracademy.in
DEV_ADMIN_PASSWORD=ChangeMe@2026!
DEV_TEACHER_EMAIL=coach@youracademy.in
DEV_TEACHER_PASSWORD=Coach@2026!
