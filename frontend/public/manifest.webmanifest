{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Amit Academy — Ratnagiri",
  "short_name": "Amit Academy",
  "description": "Amit Academy Ratnagiri — Official Academy Management & Student Portal",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#020617",
  "theme_color": "#020617",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "categories": [
    "education",
    "sports",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "1024x912",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Student Attendance",
      "short_name": "Attendance",
      "url": "/student/attendance",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Fee Records",
      "short_name": "Fees",
      "url": "/student/fees",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
